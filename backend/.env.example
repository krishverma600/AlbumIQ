DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=ai_wedding_photos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FRONTEND_BASE_URL=http://localhost:5173
# Blank uses the active recognition model's matching threshold.
FACE_MATCH_THRESHOLD=
FACE_DETECTION_MODEL=hog
FACE_ENGINE_PROVIDER=deepface
DEEPFACE_MODEL=ArcFace
DEEPFACE_DETECTOR_BACKEND=yunet
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PASSWORD_RESET_OTP_LENGTH=6
PASSWORD_RESET_OTP_TTL_MINUTES=10

# Enable only after installing django-storages[s3] and configuring AWS variables.
USE_S3=False
CELERY_TASK_ALWAYS_EAGER=False
# Face detection confidence only; identity matching threshold is model-specific.
YUNET_SCORE_THRESHOLD=0.8
